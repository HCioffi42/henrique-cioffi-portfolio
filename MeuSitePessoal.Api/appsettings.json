{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MeuSiteDb;Username=postgres;Password=;Include Error Detail=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  
  "ForwardedHeaders": {
    "TrustedNetwork": "172.16.0.0",
    "TrustedNetworkPrefixLength": 12
  },

  "RateLimiting": {
    "Policies": {
      "auth-signin": { "PermitLimit": 10, "WindowMinutes": 15 },
      "auth-verify": { "PermitLimit": 5, "WindowMinutes": 15 },
      "auth-register": { "PermitLimit": 5, "WindowMinutes": 60 },
      "auth-recovery": { "PermitLimit": 5, "WindowMinutes": 60 },
      "comments-write": { "PermitLimit": 10, "WindowMinutes": 5 },
      "newsletter-subscribe": { "PermitLimit": 3, "WindowMinutes": 60 }
    }
  },

  "JwtSettings": {
    "Issuer": "MeuSitePessoal",
    "Audience": "MeuSitePessoal-Api",
    "ExpiresInMinutes": 60
  },
  "StorageSettings": {
    "LocalStoragePath": "wwwroot/uploads"
  },
  "OAuthSettings": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "GitHub": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  
  "ApiSettings": {
    "BaseUrl": "https://hcioffi.dev"
  },
  "ClientSettings": {
    "BaseUrl": "https://hcioffi.dev"
  },
  "AllowedHosts": "*",
  
  "EmailSettings": {
    "Host": "smtp.resend.com",
    "Port": 587,
    "Username": "resend",
    "Password": "YOUR_RESEND_PASSWORD",
    "SenderEmail": "no-reply@hcioffi.dev",
    "SenderName": "Henrique Cioffi | Software Engineer",
    "EnableSsl": true
  }
}
