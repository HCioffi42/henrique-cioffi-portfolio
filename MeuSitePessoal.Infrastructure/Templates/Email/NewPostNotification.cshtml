@model MeuSitePessoal.Application.Common.Models.Email.NewPostNotificationViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        /* CSS styles preserved for email client compatibility */
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #eee; border-radius: 8px; }
        .masthead { font-size: 14px; letter-spacing: 1px; text-transform: uppercase; color: #888; }
        .headline { color: #4f46e5; font-size: 24px; font-weight: bold; }
        .summary { font-style: italic; }
        .button { display: inline-block; padding: 12px 24px; background-color: #4f46e5; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: bold; }
        .cta { text-align: center; margin: 30px 0; }
        .separator { margin: 40px 0; border: 0; border-top: 1px solid #eee; }
        .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #eee; font-size: 12px; color: #888; text-align: center; }
    </style>
</head>
<body>
<div class="container">
    <div class="masthead">hcioffi.dev</div>

    @if (Model.ShowEnglish)
    {
        <div class="headline">@Model.TitleEn</div>

        <p class="summary">@Model.SummaryEn</p>

        <p>I've just published a new article on <strong>hcioffi.dev</strong>. Check it out!</p>

        <div class="cta">
            <a href="@Model.ArticleUrl" class="button">Read Full Article</a>
        </div>
    }

    @if (Model.ShowEnglish && Model.ShowPortuguese)
    {
        <hr class="separator" />
    }

    @if (Model.ShowPortuguese)
    {
        <div class="headline">@Model.TitlePt</div>

        <p class="summary">@Model.SummaryPt</p>

        <p>Acabei de publicar um novo artigo no <strong>hcioffi.dev</strong>. Confira!</p>

        <div class="cta">
            <a href="@Model.ArticleUrl" class="button">Ler Artigo Completo</a>
        </div>
    }

    <div class="footer">
        <p>You are receiving this because you subscribed to the newsletter at hcioffi.dev.</p>
        <p>Voce esta recebendo este email porque se inscreveu na newsletter do hcioffi.dev.</p>
        <a href="@Model.UnsubscribeUrl" style="color: #999;">Unsubscribe / Cancelar inscricao</a>
    </div>
</div>
</body>
</html>
