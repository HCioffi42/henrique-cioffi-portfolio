@using MeuSitePessoal.Application.Common.Models.Email
@model ResetPasswordViewModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Reset Your Password";
}

<h2>Password Reset Request</h2>
<p>Hello, @Model.UserName!</p>
<p>We received a request to reset the password for your account. If you didn't request this, you can safely ignore this email; your password will remain unchanged.</p>
<p>To set a new password, please click the button below:</p>

<div style="text-align: center;">
    <a href="@Model.ResetLink" class="button">Reset Password</a>
</div>

<p>If the button doesn't work, you can also copy and paste the following link into your browser:</p>
<p style="word-break: break-all; font-size: 14px; color: #5e6ad2;">
    @Model.ResetLink
</p>

<div class="divider"></div>
<p>For your security, this link will expire in 24 hours.</p>
