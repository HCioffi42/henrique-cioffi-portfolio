<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>@ViewBag.Title</title>
    <style>
        /* Base styles for email client compatibility */
        body {
            background-color: #f6f9fc;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
            color: #333333;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            padding: 40px 0;
            text-align: center;
        }

        .header h1 {
            color: #1a1a1a;
            font-size: 24px;
            font-weight: 700;
            letter-spacing: 2px;
            margin: 0;
            text-transform: uppercase;
        }

        .content {
            background-color: #ffffff;
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .footer {
            padding: 30px 0;
            text-align: center;
            font-size: 13px;
            color: #8898aa;
        }

        .footer a {
            color: #5e6ad2;
            text-decoration: none;
        }

        .button {
            display: inline-block;
            background-color: #000000;
            color: #ffffff !important;
            padding: 14px 30px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            margin: 20px 0;
        }

        h2 {
            font-size: 20px;
            margin-top: 0;
            color: #1a1a1a;
        }

        p {
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .divider {
            border-top: 1px solid #e6ebf1;
            margin: 30px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>HCIOFFI.DEV</h1>
        </div>
        <div class="content">
            @RenderBody()
        </div>
        <div class="footer">
            <p>&copy; @DateTime.UtcNow.Year Henrique Cioffi. All rights reserved.</p>
            <p>
                <a href="https://hcioffi.dev">Website</a> | 
                <a href="https://github.com/hcioffi">GitHub</a> | 
                <a href="https://linkedin.com/in/henriquecioffi">LinkedIn</a>
            </p>
            <p>This is an automated message, please do not reply.</p>
        </div>
    </div>
</body>
</html>
